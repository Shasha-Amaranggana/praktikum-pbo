# G.  CLASS USER
#     ⤷ Class atur User
# ═════════════════════════════════════════════════════════════════
class user:
    totalUser = 0
    statusUser = "Aktif"

    def __init__(self, username, password, email, alamat, saldo):
        self.username = username
        self.email = email
        self.alamat = alamat
        self.__password = password
        self.__saldo = saldo
        self.daftarPesanan = []
        self.keranjang = None
        user.totalUser += 1

    def login(self, username, password):
        if self.username == username and self.__password == password:
            return True
        else:
            return False

    def pembelian(self, merchandise, jumlah):
        total = merchandise.hargaAkhir * jumlah
        if self.__saldo >= total and merchandise.stok >= jumlah:
            self.__saldo -= total
            merchandise.stok -= jumlah
            return True
        else:
            return False

    def buatKeranjang(self):
        if self.keranjang is None:
            self.keranjang = keranjang()
        return self.keranjang


    # GETTER SETTER
    # ════════════════════════════════════════════════════════
    @property
    def saldo(self):
        return self.__saldo
    @saldo.setter
    def saldo(self, saldo):
        if saldo < 0:
            raise ValueError("Saldo tidak boleh negatif.")
        self.__saldo = saldo

    @property
    def password(self):
        return self.__password
    @password.setter
    def password(self, password):
        if password == "":
            raise ValueError("Password tidak boleh kosong.")
        self.__password = password



