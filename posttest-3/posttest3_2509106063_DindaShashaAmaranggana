# E.  CLASS KERANJANG
#     ⤷ Class atur Keranjang
# ═════════════════════════════════════════════════════════════════
class keranjang:
    def __init__(self):
        self.daftarMerch = []

    def tampilkanKeranjang(self):
        if len(self.daftarMerch) == 0:
            print("Keranjang masih kosong.")
            return
        print("[Isi Keranjang]")
        total = 0
        for item in self.daftarMerch:
            merch = item["merchandise"]
            jumlah = item["jumlah"]
            subtotal = merch.hargaAkhir * jumlah
            print("Merchandise  :", merch.nama)
            print("Jumlah       :", jumlah)
            print("Harga        :", f"Rp{merch.hargaAkhir}")
            print("Subtotal     :", f"Rp{subtotal}") 
            print()
            total += subtotal
        print("Total Keranjang :", f"Rp{total}")

    def tambahKeranjang(self, merchandise, jumlah):
        if jumlah <= 0:
            raise ValueError("Jumlah merchandise harus lebih dari 0.")
        if merchandise.stok < jumlah:
            print("Stok merchandise tidak mencukupi.")
            return False
        self.daftarMerch.append({"merchandise": merchandise, "jumlah": jumlah})
        return True


    # OVERLOADING
    # ════════════════════════════════════════════════════════
    def __len__(self):
        return len(self.daftarMerch)



