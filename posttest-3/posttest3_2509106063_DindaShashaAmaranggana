# F.  CLASS PESANAN
#     ⤷ Class atur Pesanan
# ═════════════════════════════════════════════════════════════════
class pesanan: 
    statusPesanan = "Menunggu Pembayaran"
    totalPesanan = 0
    daftarPesanan = []

    def __init__(self, user):
        self.user = user
        self.daftarDetail = []
        self.__status = pesanan.statusPesanan
        pesanan.totalPesanan += 1
        pesanan.daftarPesanan.append(self)
        user.daftarPesanan.append(self)

    def tambahDetail(self, merchandise, jumlah):
        detail = detailPesanan(merchandise, jumlah)
        self.daftarDetail.append(detail)

    def tampilkanPesanan(self):
        print("User         :", self.user.username)
        for detail in self.daftarDetail:
            detail.tampilkanDetail()
        print("Status       :", self.__status)

    def kirimPesanan(self, kanal):
        self.__status = "Dikirim"
        print("Pesanan telah dikirim kepada", self.user.username)
        kanal.kirim(f"Pesanan atas nama {self.user.username} sedang dikirim.")


    # GETTER SETTER
    # ════════════════════════════════════════════════════════
    @property
    def status(self):
        return self.__status
    @status.setter
    def status(self, status):
        if status == "":
            raise ValueError("Status tidak boleh kosong.")
        self.__status = status


    @classmethod
    def totalSemuaPesanan(cls):
        total = 0
        for pesanan in cls.daftarPesanan:
            for detail in pesanan.daftarDetail:
                total += detail.merchandise.hargaAkhir * detail.jumlah
        return total



