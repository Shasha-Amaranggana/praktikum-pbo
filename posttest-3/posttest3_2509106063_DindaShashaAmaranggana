from abc import ABC, abstractmethod



# ═════════════════════════════════════════════════════════════════
# A.  CLASS MERCHANDISE (ABSTRACT)
#     ⤷ Class atur merchandise
# ═════════════════════════════════════════════════════════════════
class merchandise(ABC):
    totalMerchandise = 0

    def __init__(self, nama, harga, stok):
        self.nama = nama
        self._harga = harga
        self.__stok = stok
        merchandise.totalMerchandise += 1


    # METHOD ABSTRACT
    # ════════════════════════════════════════════════════════
    @abstractmethod
    def hitungBiayaTambahan(self):
        # Biaya tambahan sesuai spesifikasi jenis merchandise.
        pass

    @abstractmethod
    def infoKhusus(self):
        # Informasi unik tiap jenis merchandise.
        pass


    # METHOD KONKRET
    # ════════════════════════════════════════════════════════
    def tampilkanInfo(self):
        print("Nama Merchandise  :", self.nama)
        print(f"Harga Dasar       : Rp{self._harga}")
        print(f"Harga Akhir       : Rp{self.hargaAkhir}")
        print("Stok              :", self.__stok)
        self.infoKhusus()


    # GETTER SETTER
    # ════════════════════════════════════════════════════════
    @property
    def hargaAkhir(self):
        return self._harga + self.hitungBiayaTambahan()

    @property
    def harga(self):
        return self._harga
    @harga.setter
    def harga(self, harga):
        if harga < 0:
            raise ValueError("Harga tidak boleh negatif.")
        self._harga = harga

    @property
    def stok(self):
        return self.__stok
    @stok.setter
    def stok(self, stok):
        if stok < 0:
            raise ValueError("Stok tidak boleh negatif.")
        self.__stok = stok


    # METHOD STATIC
    # ════════════════════════════════════════════════════════
    @staticmethod
    def hitungDiskon(harga, persen):
        return harga - (harga * persen / 100)


    # OVERLOADING
    # ════════════════════════════════════════════════════════
    def __str__(self):
        return f"{self.nama} (Rp{self.hargaAkhir})"

    def __lt__(self, lain):
        return self.hargaAkhir < lain.hargaAkhir



