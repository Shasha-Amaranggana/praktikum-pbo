# D.  CLASS DETAIL PESANAN
#     ⤷ Class atur Detail Pesanan
# ═════════════════════════════════════════════════════════════════
class detailPesanan:
    def __init__(self, merchandise, jumlah):
        self.merchandise = merchandise
        self.__jumlah = jumlah

    def tampilkanDetail(self):
        print("Merchandise  :", self.merchandise.nama)
        print("Jumlah       :", self.__jumlah)
        print("Harga        :", f"Rp{self.merchandise.hargaAkhir}")
        print("Subtotal     :", f"Rp{self.merchandise.hargaAkhir * self.__jumlah}")


    # GETTER SETTER
    # ════════════════════════════════════════════════════════
    @property
    def jumlah(self):
        return self.__jumlah
    @jumlah.setter
    def jumlah(self, jumlah):
        if jumlah <= 0:
            raise ValueError("Jumlah pesanan harus lebih dari 0.")
        self.__jumlah = jumlah



