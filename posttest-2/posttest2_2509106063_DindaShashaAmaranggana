# CLASS DETAILPESANAN
# ============================
class detailPesanan:
    def __init__(self, merchandise, jumlah):
        self.merchandise = merchandise
        self.__jumlah = jumlah

    def tampilkanDetail(self):
        print("Merchandise  :", self.merchandise.nama)
        print("Jumlah       :", self.__jumlah)
        print("Harga        :", f"Rp{self.merchandise.harga}")
        print("Subtotal     :", f"Rp{self.merchandise.harga * self.__jumlah}")

    @property
    def jumlah(self):
        return self.__jumlah
    @jumlah.setter
    def jumlah(self, jumlah):
        if jumlah <= 0:
            raise ValueError("Jumlah pesanan harus lebih dari 0.")
        self.__jumlah = jumlah


# CLASS KERANJANG
# ============================
class keranjang:
    def __init__(self):
        self.daftarMerch = []

    def tampilkanKeranjang(self):
        if len(self.daftarMerch) == 0:
            print("Keranjang masih kosong.")
            return
        print("[Isi Keranjang]")
        total = 0
        for item in self.daftarMerch:
            merch = item["merchandise"]
            jumlah = item["jumlah"]
            subtotal = merch.harga * jumlah
            print("Merchandise  :", merch.nama)
            print("Jumlah       :", jumlah)
            print("Harga        :", f"Rp{merch.harga}")
            print("Subtotal     :", f"Rp{subtotal}") 
            print()
            total += subtotal
        print("Total Keranjang :", f"Rp{total}")

    def tambahKeranjang(self, merchandise, jumlah):
        if jumlah <= 0:
            raise ValueError("Jumlah merchandise harus lebih dari 0.")
        if merchandise.stok < jumlah:
            print("Stok merchandise tidak mencukupi.")
            return False
        self.daftarMerch.append({"merchandise": merchandise, "jumlah": jumlah})
        return True

    
# CLASS PESANAN
# ============================
class pesanan: 
    statusPesanan = "Menunggu Pembayaran"
    totalPesanan = 0
    daftarPesanan = []

    def __init__(self, user):
        self.user = user
        self.daftarDetail = []
        self.__status = pesanan.statusPesanan
        pesanan.totalPesanan += 1
        pesanan.daftarPesanan.append(self)
        user.daftarPesanan.append(self)

    def tambahDetail(self, merchandise, jumlah):
        detail = detailPesanan(merchandise, jumlah)
        self.daftarDetail.append(detail)

    def tampilkanPesanan(self):
        print("User         :", self.user.username)
        for detail in self.daftarDetail:
            detail.tampilkanDetail()
        print("Status       :", self.__status)

    def kirimPesanan(self):
        self.__status = "Dikirim"
        print("Pesanan telah dikirim kepada", self.user.username)

    @property
    def status(self):
        return self.__status
    @status.setter
    def status(self, status):
        if status == "":
            raise ValueError("Status tidak boleh kosong.")
        self.__status = status

    @classmethod
    def totalSemuaPesanan(cls):
        total = 0
        for pesanan in cls.daftarPesanan:
            for detail in pesanan.daftarDetail:
                total += detail.merchandise.harga * detail.jumlah
        return total


# CLASS USER
# ============================
class user:
    totalUser = 0
    statusUser = "Aktif"

    def __init__(self, username, password, email, alamat, saldo):
        self.username = username
        self.email = email
        self.alamat = alamat
        self.__password = password
        self.__saldo = saldo
        self.daftarPesanan = []
        self.keranjang = None
        user.totalUser += 1

    def login(self, username, password):
        if self.username == username and self.__password == password:
            return True
        else:
            return False

    def pembelian(self, merchandise, jumlah):
        total = merchandise.harga * jumlah
        if self.__saldo >= total and merchandise.stok >= jumlah:
            self.__saldo -= total
            merchandise.stok -= jumlah
            return True
        else:
            return False

    def buatKeranjang(self):
        if self.keranjang is None:
            self.keranjang = keranjang()
        return self.keranjang

    @property
    def saldo(self):
        return self.__saldo
    @saldo.setter
    def saldo(self, saldo):
        if saldo < 0:
            raise ValueError("Saldo tidak boleh negatif.")
        self.__saldo = saldo

    @property
    def password(self):
        return self.__password
    @password.setter
    def password(self, password):
        if password == "":
            raise ValueError("Password tidak boleh kosong.")
        self.__password = password


